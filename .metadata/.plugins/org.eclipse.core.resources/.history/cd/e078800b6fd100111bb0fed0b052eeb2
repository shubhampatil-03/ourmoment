
package com.ourmoment.dto;

import java.time.LocalDateTime;
import com.ourmoment.entity.Invitation;

public class InvitationResponseDto {

    private Long id;
    private String recipientName;
    private String title;
    private String message;
    private String occasion;
    private LocalDateTime eventDate;
    private String shareToken;
    private String responseStatus;
    private LocalDateTime createdAt;

    public InvitationResponseDto(Invitation i) {
        id = i.getId();
        recipientName = i.getRecipientName();
        title = i.getTitle();
        message = i.getMessage();
        occasion = i.getOccasion();
        eventDate = i.getEventDate();
        shareToken = i.getShareToken();
        responseStatus = i.getResponseStatus();
        createdAt = i.getCreatedAt();
    }

    public Long getId() { return id; }
    public String getRecipientName() { return recipientName; }
    public String getTitle() { return title; }
    public String getMessage() { return message; }
    public String getOccasion() { return occasion; }
    public LocalDateTime getEventDate() { return eventDate; }
    public String getShareToken() { return shareToken; }
    public String getResponseStatus() { return responseStatus; }
    public LocalDateTime getCreatedAt() { return createdAt; }
}
